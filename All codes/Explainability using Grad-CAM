":"completed"},"tags":[]},"source":["# **Attention Modules (CBAM)**"]},{"cell_type":"code","execution_count":8,"id":"d3b266c8","metadata":{"execution":{"iopub.execute_input":"2025-12-07T04:22:36.718715Z","iopub.status.busy":"2025-12-07T04:22:36.718477Z","iopub.status.idle":"2025-12-07T04:22:36.723789Z","shell.execute_reply":"2025-12-07T04:22:36.723072Z"},"papermill":{"duration":0.036087,"end_time":"2025-12-07T04:22:36.724898","exception":false,"start_time":"2025-12-07T04:22:36.688811","status":"completed"},"tags":[]},"outputs":[],"source":["class ChannelAttention(nn.Module):\n","    def __init__(self, in_planes, ratio=16):\n","        super(ChannelAttention, self).__init__()\n","        self.avg_pool = nn.AdaptiveAvgPool2d(1)\n","        self.max_pool = nn.AdaptiveMaxPool2d(1)\n","        self.fc1   = nn.Conv2d(in_planes, in_planes // ratio, 1, bias=False)\n","        self.relu1 = nn.ReLU()\n","        self.fc2   = nn.Conv2d(in_planes // ratio, in_planes, 1, bias=False)\n","        self.sigmoid = nn.Sigmoid()\n","\n","    def forward(self, x):\n","        avg_out = self.fc2(self.relu1(self.fc1(self.avg_pool(x))))\n","        max_out = self.fc2(self.relu1(self.fc1(self.max_pool(x))))\n","        out = avg_out + max_out\n","        return self.sigmoid(out)"]},{"cell_type":"code","execution_count":9,"id":"72fb3afd","metadata":{"execution":{"iopub.execute_input":"2025-12-07T04:22:36.785454Z","iopub.status.busy":"2025-12-07T04:22:36.785179Z","iopub.status.idle":"2025-12-07T04:22:36.790245Z","shell.execute_reply":"2025-12-07T04:22:36.789546Z"},"papermill":{"duration":0.036943,"end_time":"2025-12-07T04:22:36.791382","exception":false,"start_time":"2025-12-07T04:22:36.754439","status":"completed"},"tags":[]},"outputs":[],"source":["class SpatialAttention(nn.Module):\n","    def __init__(self, kernel_size=7):\n","        super(SpatialAttention, self).__init__()\n","        padding = 3 if kernel_size == 7 else 1\n","        self.conv1 = nn.Conv2d(2, 1, kernel_size, padding=padding, bias=False)\n","        self.sigmoid = nn.Sigmoid()\n","\n","    def forward(self, x):\n","        avg_out = torch.mean(x, dim=1, keepdim=True)\n","        max_out, _ = torch.max(x, dim=1, keepdim=True)\n","        x = torch.cat([avg_out, max_out], dim=1)\n","        x = self.conv1(x)\n","        return self.sigmoid(x)"]},{"cell_type":"code","execution_count":10,"id":"0e7564de","metadata":{"execution":{"iopub.execute_input":"2025-12-07T04:22:36.851557Z","iopub.status.busy":"2025-12-07T04:22:36.85129Z","iopub.status.idle":"2025-12-07T04:22:36.855824Z","shell.execute_reply":"2025-12-07T04:22:36.855045Z"},"papermill":{"duration":0.036546,"end_time":"2025-12-07T04:22:36.857041","exception":false,"start_time":"2025-12-07T04:22:36.820495","status":"completed"},"tags":[]},"outputs":[],"source":["class CBAM(nn.Module):\n","    def __init__(self, planes, ratio=16, kernel_size=7):\n","        super(CBAM, self).__init__()\n","        self.ca = ChannelAttention(planes, ratio)\n","        self.sa = SpatialAttention(kernel_size)\n","\n","    def forward(self, x):\n","        x = x * self.ca(x)\n","        x = x * self.sa(x)\n","        return x"]},{"cell_type":"code","execution_count":11,"id":"7cd60daa","metadata":{"execution":{"iopub.execute_input":"2025-12-07T04:22:36.916236Z","iopub.status.busy":"2025-12-07T04:22:36.916019Z","iopub.status.idle":"2025-12-07T04:22:36.922721Z","shell.execute_reply":"2025-12-07T04:22:36.922009Z"},"papermill":{"duration":0.037515,"end_time":"2025-12-07T04:22:36.923762","exception":false,"start_time":"2025-12-07T04:22:36.886247","status":"completed"},"tags":[]},"outputs":[],"source":["class AttentionCervicalNet(nn.Module):\n","    def __init__(self, num_classes):\n","        super(AttentionCervicalNet, self).__init__()\n","        \n","        self.features = nn.Sequential(\n","            # Block 1\n","            nn.Conv2d(3, 32, kernel_size=3, stride=1, padding=1),\n","            nn.BatchNorm2d(32),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2),\n","            # Block 2\n","            nn.Conv2d(32, 64, kernel_size=3, stride=1, padding=1),\n","            nn.BatchNorm2d(64),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2),\n","            # Block 3\n","            nn.Conv2d(64, 128, kernel_size=3, stride=1, padding=1),\n","            nn.BatchNorm2d(128),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2),\n","            # Block 4\n","            nn.Conv2d(128, 256, kernel_size=3, stride=1, padding=1),\n","            nn.BatchNorm2d(256),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2),\n","            # Block 5\n","            nn.Conv2d(256, 512, kernel_size=3, stride=1, padding=1),\n","            nn.BatchNorm2d(512),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2, 2),\n","        )\n","        \n","        # CBAM Attention\n","        self.attention = CBAM(planes=512)\n","        \n","        # Classifier\n","        self.classifier = nn.Sequential(\n","            nn.Flatten(),\n","            nn.Linear(512 * 7 * 7, 1024),\n","            nn.ReLU(),\n","            nn.Dropout(0.5),\n","            nn.Linear(1024, num_classes)\n","        )\n","        \n","    def forward(self, x):\n","        x = self.features(x)\n","        x = self.attention(x)\n","        x = self.classifier(x)\n","        return x"]},{"cell_type":"code","execution_count":12,"id":"9bcfb443","metadata":{"execution":{"iopub.execute_input":"2025-12-07T04:22:36.983084Z","iopub.status.busy":"2025-12-07T04:22:36.982848Z","iopub.status.idle":"2025-12-07T04:22:37.432781Z","shell.execute_reply":"2025-12-07T04:22:37.432147Z"},"papermill":{"duration":0.481211,"end_time":"2025-12-07T04:22:37.434083","exception":false,"start_time":"2025-12-07T04:22:36.952872","status":"completed"},"tags":[]},"outputs":[],"source":["att_model = AttentionCervicalNet(num_classes).to(device)\n","optimizer = optim.Adam(att_model.parameters(), lr=learning_rate, weight_decay=decay)\n","criterio